# Backend rodando diretamente no computador: use seu MySQL local.
NODE_ENV=development
PORT=3000
# Connects a host-run backend to Redis from Docker Compose.
REDIS_URL=redis://127.0.0.1:6380/1
EMAIL_SERVICE_URL=http://127.0.0.1:3040
EMAIL_API_KEY=replace-with-the-same-long-random-key-used-by-UrbanCandy_email
# Mercado Pago test credentials (keep these values private).
MERCADOPAGO_ACCESS_TOKEN=replace-with-your-test-access-token
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=urbancandy
DB_USER=root
DB_PASSWORD=replace-with-your-local-mysql-password
JWT_SECRET=replace-with-a-long-random-secret
