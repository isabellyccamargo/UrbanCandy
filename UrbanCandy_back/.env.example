# Exemplo de variáveis de ambiente para o backend UrbanCandy

# Banco de dados principal
DATABASE_URL=postgres://user:password@localhost:5432/urbancandy

# Banco de dados de teste (usado nos testes E2E e unitários)
DATABASE_URL_TEST=postgres://user:password@localhost:5432/urbancandy_test

# Porta do servidor
PORT=3000

# JWT Secret
JWT_SECRET=sua_chave_secreta_aqui
