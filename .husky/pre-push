#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "-----------------------------------------------------------------------------------------------------------------------------------------------------------"
echo "🔍 Etapa 1/4: Corrigindo código com ESLint no Backend..."
npm --prefix UrbanCandy_back run lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint encontrou erros críticos no Backend. Push abortado."
  exit 1
fi

echo "🔍 Etapa 1/4: Corrigindo código com ESLint no Frontend..."
npm --prefix UrbanCandy_front run lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint encontrou erros críticos no Frontend. Push abortado."
  exit 1
fi

echo "-----------------------------------------------------------------------------------------------------------------------------------------------------------"
echo "✨ Etapa 2/4: Formatando código com Prettier no Backend..."
npm --prefix UrbanCandy_back run format

echo "✨ Etapa 2/4: Formatando código com Prettier no Frontend..."
npm --prefix UrbanCandy_front run format

echo "-----------------------------------------------------------------------------------------------------------------------------------------------------------"
echo "🧪 Etapa 3/4: Executando testes com Jest no Backend..."
npm --prefix UrbanCandy_back test -- --passWithNoTests
if [ $? -ne 0 ]; then
  echo "❌ Testes no Backend falharam. Push abortado."
  exit 1
fi

echo "🧪 Etapa 3/4: Executando testes com Jest no Frontend..."
npm --prefix UrbanCandy_front test -- --passWithNoTests
if [ $? -ne 0 ]; then
  echo "❌ Testes no Frontend falharam. Push abortado."
  exit 1
fi

echo "-----------------------------------------------------------------------------------------------------------------------------------------------------------"
echo "🚀 Iniciando o Servidor Backend em modo de TESTE (em segundo plano)..."

NODE_ENV=test npm --prefix UrbanCandy_back run dev &

BACKEND_PID=$!

echo "⏳ Aguardando 5 segundos para o Backend de testes iniciar completamente..."
sleep 5
echo "-----------------------------------------------------------------------------------------------------------------------------------------------------------"

echo "🎭 Etapa 4/4: Executando testes End-to-End com Playwright no Frontend..."
npm --prefix UrbanCandy_front run test:e2e
FRONTEND_E2E_STATUS=$?

echo "-----------------------------------------------------------------------------------------------------------------------------------------------------------"
echo "🧹 Desligando o servidor Backend de testes..."
kill $BACKEND_PID 2>/dev/null

if [ $FRONTEND_E2E_STATUS -ne 0 ]; then
  echo "❌ Testes E2E no Frontend falharam. Push abortado."
  exit 1
fi

echo "✅ Todas as validações passaram! Push permitido."

