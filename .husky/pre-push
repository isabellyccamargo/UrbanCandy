#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-push hooks..."

echo "🧪 Running backend tests..."
npm --prefix UrbanCandy_back test -- --passWithNoTests || { echo "❌ Backend tests failed. Push aborted."; exit 1; }

echo "🧪 Running frontend tests..."

npm --prefix UrbanCandy_front test -- --passWithNoTests || { echo "❌ Frontend tests failed. Push aborted."; exit 1; }

echo "🎭 Running backend E2E tests..."
npm --prefix UrbanCandy_back run test:e2e 2>/dev/null || echo "⚠️  Backend E2E tests not implemented yet (expected at this phase)."

echo "🎭 Running frontend E2E tests..."
npm --prefix UrbanCandy_front run test:e2e 2>/dev/null || echo "⚠️  Frontend E2E tests not implemented yet (expected at this phase)."

echo "✅ All tests passed. Push allowed."