# Usado somente pelo Docker Compose; não reutiliza o banco local ou o de testes.
DOCKER_DB_NAME=urbancandy_docker
DOCKER_DB_USER=urbancandy_app
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
JWT_SECRET=replace-with-a-long-random-secret
# Mercado Pago test credentials (keep these values private).
MERCADOPAGO_ACCESS_TOKEN=replace-with-your-test-access-token
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=
# Portas publicadas  no computador host.
MYSQL_PORT=3307
BACKEND_PORT=3030
HTTP_PORT=80
HTTPS_PORT=443
# API destination for urbancandy.local; default keeps the Docker backend.
BACKEND_UPSTREAM=urbancandy-backend:3030
# Loopback-only Redis port for a backend/mobile app running directly on the host.
REDIS_PORT=6380
# Interfaces locais de observabilidade (somente loopback).
PRODUCT_CACHE_TTL_SECONDS=60
# Separate email-service MySQL database and SMTP credentials.
EMAIL_DB_NAME=urbancandy_email_docker
EMAIL_DB_USER=urbancandy_email
EMAIL_DB_PASSWORD=replace-with-a-strong-email-database-password
EMAIL_DB_ROOT_PASSWORD=replace-with-a-different-email-database-root-password
EMAIL_SERVICE_PORT=3041
EMAIL_API_KEY=replace-with-the-same-long-random-key-used-by-UrbanCandy_email
# Keep the Grafana administrator password private.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
