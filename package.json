{
    "name": "urbancandy-monorepo",
    "version": "1.0.0",
    "private": true,
    "description": "Monorepo for UrbanCandy project (Backend, Frontend, AI)",
    "main": "index.js",
    "scripts": {
        "postinstall": "husky install",
        "lint:back": "npm --prefix UrbanCandy_back run lint",
        "lint:front": "npm --prefix UrbanCandy_front run lint",
        "format:back": "npm --prefix UrbanCandy_back run format",
        "format:front": "npm --prefix UrbanCandy_front run format",
        "test:back": "npm --prefix UrbanCandy_back test",
        "test:e2e:back": "npm --prefix UrbanCandy_back run test:e2e",
        "test:e2e:front": "npm --prefix UrbanCandy_front run test:e2e",
        "dev:back": "npm --prefix UrbanCandy_back run dev",
        "dev:front": "npm --prefix UrbanCandy_front run dev",
        "build:front": "npm --prefix UrbanCandy_front run build"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@commitlint/config-conventional": "^21.0.1",
        "commitlint": "^21.0.1",
        "husky": "^9.1.7"
    },
    "workspaces": [
        "UrbanCandy_back",
        "UrbanCandy_front"
    ]
}